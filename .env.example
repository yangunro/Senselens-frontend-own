# ---------------------------------------------------------------------
# SenseLens backend environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------

# Database — use EITHER a single connection URL ...
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ... OR the individual DB_* settings (Supabase Session Pooler).
DB_USER=postgres.<PROJECT_REF>
DB_PASSWORD=
DB_HOST=<SUPABASE_SESSION_POOLER_HOST>
DB_PORT=5432
DB_NAME=postgres

# Server-side Mapbox access token, used by the backend to call the
# Mapbox Directions API for walking-route computation. Server-side only —
# never expose the routing token through a VITE_* variable.
MAPBOX_ACCESS_TOKEN=

# Comma-separated frontend origins allowed by CORS, without trailing slashes.
FRONTEND_ORIGIN=http://localhost:5173,https://senselens.onrender.com
