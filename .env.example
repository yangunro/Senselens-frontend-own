# Use either DATABASE_URL or the individual DB_* settings.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Existing FastAPI Cloud deployments may keep using these instead.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# Server-side Google Routes API key. Never expose this through a VITE_* variable.
GOOGLE_ROUTES_API_KEY=

# Comma-separated frontend origins, without trailing slashes.
FRONTEND_ORIGIN=http://localhost:5173,https://senselens.onrender.com
