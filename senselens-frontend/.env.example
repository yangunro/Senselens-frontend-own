# Backend API base URL. Leave empty to keep using mock data in src/services/.
# Once the backend teammate shares the real address, copy this file to .env
# and fill it in — no component code needs to change.
VITE_API_BASE=

# Google Maps JavaScript API key (Maps JavaScript API enabled in Google Cloud Console).
# Copy this file to .env.local and fill it in — .env.local is gitignored.
VITE_GOOGLE_MAPS_API_KEY=
